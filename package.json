    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
