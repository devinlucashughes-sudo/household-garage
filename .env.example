# Local development works without an env file. Copy to .env.local if needed.
# Never commit .env.local or your database.
DATABASE_PATH=./data/garage.db
APP_ORIGIN=http://localhost:3000
TZ_NAME=America/Chicago
# Optional: Google Drive backups, configured with your own OAuth application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: web push reminders. Generate with npx web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URL or mailto address for push services; defaults to APP_ORIGIN.
VAPID_SUBJECT=
